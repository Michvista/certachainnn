generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Certificate {
  id                Int      @id @default(autoincrement())
  certId            String   @unique
  institutionWallet String
  studentWallet     String?
  studentName       String?
  course            String?
  ipfsUrl           String?
  fileUrl           String?
  issueDate         DateTime @default(now())
}

model CustodialWallet {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  publicKey    String
  privateKey   String
  claimToken   String   @unique
  createdAt    DateTime @default(now())
}
